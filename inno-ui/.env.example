# Note: change 1111 port. It is just an example.

# Auth API. Login and logout are called on this origin.
VITE_AUTH_API_URL=http://localhost:1111

# Profiles API HTTPS origin used outside the dev proxy.
VITE_PROFILES_API_URL=https://localhost:1111

# Dev-server proxy targets.
PROFILES_PROXY_TARGET=http://localhost:1111
FACILITY_PROXY_TARGET=http://localhost:1111
